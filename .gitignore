# 実験の大きな生データ（要約CSV・meta.json・params.json は残す）
research/**/results/raw/

# 本家コード側の生成物
__pycache__/
*.pyc
.DS_Store

# LaTeX の中間ファイル
*.aux
*.dvi
*.log

# 検証用の Python 仮想環境（github/Test/1_初期セットアップ/setup_env.sh で作る）
.venv/
.pytest_cache/

# DB: 索引（runs/ から作り直せる）と、重い生データ
DB/auctionnet.duckdb
DB/auctionnet.duckdb.wal
DB/runs/*/raw/
DB/runs/*.tmp/
DB/models/*/ckpt/*/*.pth     # 学習の途中の重み（約1.3GB）。同じ条件で学習し直せば再現できる。条件・損失は meta.json と loss.csv に残る

# 学習用の公開データ（github/Test/2_学習データと学習手法/download_data.sh で取得。約80GB）
/DB/dataset/
